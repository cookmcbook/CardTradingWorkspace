[Unit]
Description=Build CardTrading Pi images when service default branches advance
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=pi
Environment=HOME=/home/pi
WorkingDirectory=/home/pi/CardTrading
ExecStart=/usr/bin/bash /home/pi/CardTrading/scripts/pi-watch-build.sh
TimeoutStartSec=30min
